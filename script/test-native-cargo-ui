#!/usr/bin/env python3

import argparse
import datetime
import hashlib
import json
import os
from pathlib import Path
import platform
import plistlib
import re
import shutil
import subprocess
import sys
import tempfile


def digest(path):
    with path.open('rb') as source:
        return hashlib.file_digest(source, 'sha256').hexdigest()


def source_state(repository):
    def git(*arguments):
        return subprocess.check_output(['git', *arguments], cwd=repository)

    untracked = git('ls-files', '--others', '--exclude-standard', '-z')
    return {
        'head': git('rev-parse', 'HEAD').decode().strip(),
        'head_tree': git('rev-parse', 'HEAD^{tree}').decode().strip(),
        'diff_sha256': hashlib.sha256(git('diff', '--binary', 'HEAD')).hexdigest(),
        'status': git('status', '--porcelain').decode(),
        'untracked_sha256': {
            os.fsdecode(name): digest(repository / os.fsdecode(name))
            for name in untracked.split(b'\0') if name
        },
    }


def main():
    parser = argparse.ArgumentParser(description='Run the complete macOS Cargo UI target in a qualified development test App')
    parser.add_argument('--output', type=Path, help='New artifact directory; existing directories are refused')
    options = parser.parse_args()
    if sys.platform != 'darwin':
        parser.exit(2, 'Blocked: this gate requires macOS, its SDK and codesign.\n')
    repository = Path(__file__).resolve().parent.parent
    if options.output is None:
        output = Path(tempfile.mkdtemp(prefix='made-native-cargo-ui-')).resolve()
    else:
        output = options.output.expanduser().resolve()
        output.mkdir(parents=True, exist_ok=False)
    print(f'Native Cargo UI evidence: {output}', flush=True)
    environment = os.environ.copy()
    environment.setdefault('CARGO_BUILD_JOBS', '2')
    environment.setdefault('CARGO_INCREMENTAL', '0')
    for profile in ['DEV', 'TEST']:
        environment.setdefault(f'CARGO_PROFILE_{profile}_DEBUG', '0')
        environment.setdefault(f'CARGO_PROFILE_{profile}_BUILD_OVERRIDE_DEBUG', '0')
    receipt = {
        'started_utc': datetime.datetime.now(datetime.timezone.utc).isoformat(),
        'source': source_state(repository),
        'platform': platform.platform(),
        'rustc': subprocess.check_output(['rustc', '-vV'], text=True),
        'qualification': 'Isolated development test App using the existing test helper ABI and canonical observer entitlement. Production admission and original test assertions/budgets remain unchanged. Native Zed UI and shipping certification are separate gates.',
        'commands': [],
        'test_environment': {name: environment.get(name) for name in ['SEED', 'ITERATIONS', 'PENDING_TRACES', 'GPUI_RUN_UNTIL_PARKED_LOG']},
        'build_environment': {name: value for name, value in environment.items() if name.startswith(('CARGO_', 'ZED_', 'RUSTFLAGS')) and not any(part in name.upper() for part in ['TOKEN', 'SECRET', 'PASSWORD', 'CREDENTIAL', 'API_KEY'])},
    }

    def run(arguments, label, current_environment=environment):
        receipt['commands'].append({'label': label, 'argv': arguments})
        with (output / f'{label}.log').open('w') as log:
            code = subprocess.run(arguments, cwd=repository, env=current_environment, stdout=log, stderr=subprocess.STDOUT).returncode
        receipt['commands'][-1]['exit_code'] = code
        (output / 'receipt.json').write_text(json.dumps(receipt, indent=2) + '\n')
        return code

    arguments = ['cargo', 'test', '--locked', '--no-fail-fast', '-p', 'cargo_ui', '--lib', '--no-run', '--message-format=json']
    code = run(arguments, 'compile-tests')
    if code:
        return code
    executables = []
    for line in (output / 'compile-tests.log').read_text().splitlines():
        try:
            message = json.loads(line)
        except json.JSONDecodeError:
            continue
        if (message.get('reason') == 'compiler-artifact'
                and message.get('profile', {}).get('test')
                and message.get('target', {}).get('name') == 'cargo_ui'
                and message.get('executable')):
            executables.append(Path(message['executable']))
            receipt['test_artifact'] = {name: message.get(name) for name in ['package_id', 'features', 'profile', 'target']}
    if len(executables) != 1:
        raise RuntimeError('Exactly one Cargo UI test executable is required')
    arguments = ['cargo', 'build', '--locked', '-p', 'native_task_helper', '--bin', 'native-cargo-runtime-observer', '--no-default-features', '--features', 'runtime-helper', '--message-format=json']
    code = run(arguments, 'compile-observer')
    if code:
        return code
    helpers = []
    for line in (output / 'compile-observer.log').read_text().splitlines():
        try:
            message = json.loads(line)
        except json.JSONDecodeError:
            continue
        if (message.get('reason') == 'compiler-artifact'
                and message.get('target', {}).get('name') == 'native-cargo-runtime-observer'
                and message.get('executable')):
            helpers.append(Path(message['executable']))
            receipt['observer_artifact'] = {name: message.get(name) for name in ['package_id', 'features', 'profile', 'target']}
    if len(helpers) != 1:
        raise RuntimeError('Exactly one canonical observer executable is required')
    app = output / 'Native Cargo UI Tests.app'
    directory = app / 'Contents/MacOS'
    directory.mkdir(parents=True)
    for source, name in [(executables[0], 'cargo-ui-tests'), (helpers[0], 'native-cargo-runtime-observer')]:
        destination = directory / name
        copied = subprocess.run(['/bin/cp', '-c', str(source), str(destination)], capture_output=True)
        if copied.returncode:
            shutil.copy2(source, destination)
    identifier = 'ai.simtropolis.validation.native-cargo-ui'
    with (app / 'Contents/Info.plist').open('wb') as file:
        plistlib.dump({'CFBundleIdentifier': identifier, 'CFBundleName': 'Native Cargo UI Tests', 'CFBundleExecutable': 'cargo-ui-tests', 'CFBundleVersion': '1', 'CFBundlePackageType': 'APPL'}, file)
    entitlement = repository / 'crates/native_task_helper/resources/native-cargo-runtime-observer.entitlements'
    receipt['entitlement_sha256'] = digest(entitlement)
    # Seal the containing App only after the nested observer's signature is final.
    for name, extra in [('native-cargo-runtime-observer', ['--options', 'runtime', '--entitlements', str(entitlement)]), ('cargo-ui-tests', [])]:
        arguments = ['/usr/bin/codesign', '--force', '--timestamp=none', '--identifier', identifier + ('.native-cargo-runtime-observer' if extra else ''), *extra, '--sign', '-', str(directory / name)]
        code = run(arguments, f'sign-{name}')
        if code:
            return code
    receipt['binaries'] = {}
    for name in ['cargo-ui-tests', 'native-cargo-runtime-observer']:
        code = run(['/usr/bin/codesign', '--verify', '--strict', str(directory / name)], f'verify-{name}')
        if code:
            return code
        receipt['binaries'][name] = digest(directory / name)
    runtime_environment = environment.copy()
    receipt['removed_runtime_build_overrides'] = {}
    # Cargo metadata must use the physical fixture's own target root, not our compiler cache.
    for name in ['CARGO_TARGET_DIR', 'CARGO_BUILD_BUILD_DIR']:
        value = runtime_environment.pop(name, None)
        if value is not None:
            receipt['removed_runtime_build_overrides'][name] = value
    code = run([str(directory / 'cargo-ui-tests'), '--nocapture', '--test-threads=1'], 'tests', runtime_environment)
    summaries = re.findall(r'^test result:.*$', (output / 'tests.log').read_text(), re.MULTILINE)
    receipt['test_summaries'] = summaries
    if code == 0 and not any(re.search(r'test result: ok\. (?:99|[1-9]\d\d+) passed;', summary) for summary in summaries):
        code = 97
        receipt['qualification_error'] = 'The complete 99-case target did not pass'
    receipt['source_after'] = source_state(repository)
    if receipt['source_after'] != receipt['source']:
        code = code or 98
        receipt['source_changed'] = True
    receipt['finished_utc'] = datetime.datetime.now(datetime.timezone.utc).isoformat()
    receipt['exit_code'] = code
    (output / 'receipt.json').write_text(json.dumps(receipt, indent=2) + '\n')
    print('\n'.join(summaries), flush=True)
    return code


if __name__ == '__main__':
    sys.exit(main())
