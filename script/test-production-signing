#!/usr/bin/env python3
"""Local signing contract tests; fixtures do not prove production signing."""
import base64
import hashlib
import importlib.machinery
import importlib.util
import io
import json
import os
from pathlib import Path
import plistlib
import shutil
import subprocess
import sys
import tarfile
import tempfile
import unittest
from unittest.mock import patch
import zipfile


def module(name, path):
    loader = importlib.machinery.SourceFileLoader(name, path)
    spec = importlib.util.spec_from_loader(name, loader)
    result = importlib.util.module_from_spec(spec)
    loader.exec_module(result)
    return result


policy = module("signing_policy", "script/check-signing-environment")
runtime = module("runtime_package", "script/bundle-managed-runtime")
linux_signature = module("linux_signature", "script/sign-linux-archive")
macos_signature = module("macos_signature", "script/verify-macos-signature")


class MacosVerification(unittest.TestCase):
    def test_package_minimum_covers_every_native_deployment_target(self):
        native = Path("Fixture.app/Contents/Resources/llama-cpp/llama-server")
        output = b"platform MACOS\n    minos 13.3\n    sdk 26.0\n"
        with patch.object(macos_signature, "run", return_value=output):
            with self.assertRaisesRegex(ValueError, "above package minimum"):
                macos_signature.verify_deployment_target(native, "10.15.7")
            self.assertEqual(macos_signature.verify_deployment_target(native, "13.3"), ["13.3"])
            self.assertEqual(macos_signature.verify_deployment_target(native, "13.3.1"), ["13.3"])
        with patch.object(macos_signature, "run", return_value=b"missing target"):
            with self.assertRaisesRegex(ValueError, "Missing native"):
                macos_signature.verify_deployment_target(native, "13.3")
        for invalid in [None, "", "13", "13.3-beta", "13.3.0.1"]:
            with self.subTest(version=invalid), self.assertRaises(ValueError):
                macos_signature.macos_version(invalid)

    def signing_paths(self, application):
        result = subprocess.run(("bash", "-c", 'source script/lib/macos-signing.sh; macos_nested_signing_paths "$1" copper', "fixture", str(application)),
                                capture_output=True, check=True)
        return [Path(os.fsdecode(path)) for path in result.stdout.split(b"\0") if path]

    def test_nested_paths_exclude_outer_executable_and_sort_inside_out(self):
        with tempfile.TemporaryDirectory() as directory:
            application = Path(directory) / "Fixture With Spaces.app"
            main = application / "Contents/MacOS/copper"
            files = [main, application / "Contents/MacOS/cli",
                     application / "Contents/Resources/llama-cpp/macos-aarch64/bin/llama-server"]
            for path in files:
                path.parent.mkdir(parents=True, exist_ok=True)
                path.write_bytes(b"fixture")
            (application / "Contents/Resources/outside-link").symlink_to(main)
            selected = self.signing_paths(application)
            self.assertEqual(set(selected), set(files) - {main})
            self.assertEqual([len(path.parts) for path in selected], sorted((len(path.parts) for path in selected), reverse=True))

    @unittest.skipUnless(sys.platform == "darwin" and shutil.which("clang"), "macOS codesign/clang required for the credential-free layout fixture")
    def test_real_macos_layout_rejects_scripts_and_metadata_in_code_slots(self):
        with tempfile.TemporaryDirectory(prefix="copper signing layout ") as directory:
            root = Path(directory)
            application = root / "Fixture.app"
            main = application / "Contents/MacOS/copper"
            main.parent.mkdir(parents=True)
            source = root / "fixture.c"
            source.write_text("int main(void) { return 0; }\n")
            subprocess.run(("clang", str(source), "-o", str(main)), capture_output=True, check=True)
            (application / "Contents/Info.plist").write_bytes(plistlib.dumps({
                "CFBundleIdentifier": "invalid.copper.signing-fixture", "CFBundleName": "Fixture",
                "CFBundleExecutable": "copper", "CFBundlePackageType": "APPL", "CFBundleVersion": "1",
            }))
            for relative in ("Contents/MacOS/cli", "Contents/Resources/git/bin/git",
                             "Contents/Resources/llama-cpp/macos-aarch64/bin/llama-server"):
                path = application / relative
                path.parent.mkdir(parents=True, exist_ok=True)
                shutil.copy2(main, path)
            receipt = application / "Contents/Resources/llama-cpp/.copper-bundled-runtime.json"
            receipt.write_text("{}")
            launcher = application / "Contents/MacOS/git"
            launcher.write_text("#!/bin/sh\nexit 0\n")
            launcher.chmod(0o755)
            signing = ["/usr/bin/codesign", "--force", "--options", "runtime", "--timestamp=none", "--sign", "-"]
            for path in self.signing_paths(application):
                if path.read_bytes()[:4] in macos_signature.MACHO:
                    subprocess.run([*signing, str(path)], capture_output=True, check=True)
            original = subprocess.run([*signing, str(application)], capture_output=True)
            self.assertNotEqual(original.returncode, 0)
            self.assertIn(b"Contents/MacOS/git", original.stderr)
            launcher.rename(application / "Contents/Resources/git/launch-git")
            (application / "Contents/Frameworks").mkdir()
            receipt.parent.rename(application / "Contents/Frameworks/llama-cpp")
            mixed = subprocess.run([*signing, str(application)], capture_output=True)
            self.assertNotEqual(mixed.returncode, 0)
            self.assertIn(b".copper-bundled-runtime.json", mixed.stderr)
            (application / "Contents/Frameworks/llama-cpp").rename(application / "Contents/Resources/llama-cpp")
            subprocess.run([*signing, str(application)], capture_output=True, check=True)
            subprocess.run(("/usr/bin/codesign", "--verify", "--deep", "--strict", str(application)), capture_output=True, check=True)
            envelope = plistlib.loads((application / "Contents/_CodeSignature/CodeResources").read_bytes())
            self.assertIn("Resources/git/launch-git", envelope["files2"])
            self.assertIn("Resources/llama-cpp/.copper-bundled-runtime.json", envelope["files2"])

    def test_developer_id_timestamp_runtime_and_team_are_required(self):
        identity = "Developer ID Application: Fixture (A1B2C3D4E5)"
        signature = f"Authority={identity}\nTeamIdentifier=A1B2C3D4E5\nTimestamp=fixture\nCodeDirectory v=20500 flags=0x10000(runtime)\n".encode()
        with patch.dict(os.environ, MACOS_SIGNING_IDENTITY=identity):
            with patch.object(macos_signature, "run", return_value=signature) as run:
                self.assertEqual(macos_signature.verify_code(Path("fixture"))["team"], "A1B2C3D4E5")
                self.assertTrue(any("=anchor apple generic" in call.args for call in run.call_args_list))
            for invalid in (signature.replace(b"Timestamp=fixture", b"Timestamp="),
                            signature.replace(b"0x10000", b"0x0"),
                            signature.replace(b"Developer ID Application:", b"Apple Development:"),
                            signature + b"Signature=adhoc\n",
                            signature.replace(b"TeamIdentifier=A1B2C3D4E5", b"TeamIdentifier=not set")):
                with self.subTest(signature=invalid), patch.object(macos_signature, "run", return_value=invalid):
                    with self.assertRaises(ValueError):
                        macos_signature.verify_code(Path("fixture"))

    @unittest.skipUnless(sys.platform == "darwin", "macOS requirement parser required")
    def test_apple_anchor_is_an_inline_requirement(self):
        signature = b"Authority=Developer ID Application: Fixture (A1B2C3D4E5)\nTeamIdentifier=A1B2C3D4E5\nTimestamp=fixture\nCodeDirectory v=20500 flags=0x10000(runtime)\n"
        with patch.dict(os.environ, MACOS_SIGNING_IDENTITY="Developer ID Application: Fixture (A1B2C3D4E5)"):
            with patch.object(macos_signature, "run", return_value=signature) as run:
                macos_signature.verify_code(Path("fixture"))
        requirement_calls = [call.args for call in run.call_args_list if "-R" in call.args]
        self.assertEqual(len(requirement_calls), 1)
        arguments = requirement_calls[0]
        requirement = arguments[arguments.index("-R") + 1]
        result = subprocess.run(("/usr/bin/csreq", "-r", requirement, "-t"), capture_output=True, check=True)
        self.assertEqual(result.stdout.strip(), b"anchor apple generic")

    def test_failed_verification_reports_native_diagnostic(self):
        failure = subprocess.CalledProcessError(1, ("codesign", "--verify"), output=b"native stdout diagnostic\n", stderr=b"invalid requirement specification\n")
        with patch.object(sys, "argv", ["verify-macos-signature", "fixture.app"]), patch.object(macos_signature, "verify", side_effect=failure):
            with patch("sys.stderr", new_callable=io.StringIO) as diagnostic:
                self.assertEqual(macos_signature.main(), 1)
        self.assertIn("invalid requirement specification", diagnostic.getvalue())
        self.assertIn("native stdout diagnostic", diagnostic.getvalue())

    def test_ticket_service_retry_requires_successful_validation(self):
        command = ("xcrun", "stapler", "validate", "fixture.app")
        failure = subprocess.CalledProcessError(68, command, output=b"ticket service unavailable\n")
        success = subprocess.CompletedProcess(command, 0, stdout=b"validated\n", stderr=b"")
        with patch.object(subprocess, "run", side_effect=[failure, success]) as run, patch("time.sleep") as sleep:
            self.assertEqual(macos_signature.run(*command), b"validated\n")
        self.assertEqual(run.call_count, 2)
        sleep.assert_called_once_with(5)
        with patch.object(subprocess, "run", side_effect=failure) as run, patch("time.sleep") as sleep:
            with self.assertRaises(subprocess.CalledProcessError):
                macos_signature.run(*command)
        self.assertEqual(run.call_count, 3)
        self.assertEqual(sleep.call_count, 2)

    def test_invalid_or_revoked_tickets_and_code_failures_are_not_retried(self):
        for command, returncode in [
            (("xcrun", "stapler", "validate", "fixture.app"), 65),
            (("xcrun", "stapler", "validate", "fixture.app"), 66),
            (("xcrun", "stapler", "validate", "fixture.app"), 77),
            (("/usr/bin/codesign", "--verify", "fixture.app"), 68),
        ]:
            with self.subTest(command=command, returncode=returncode):
                failure = subprocess.CalledProcessError(returncode, command)
                with patch.object(subprocess, "run", side_effect=failure) as run, patch("time.sleep") as sleep:
                    with self.assertRaises(subprocess.CalledProcessError):
                        macos_signature.run(*command)
                run.assert_called_once()
                sleep.assert_not_called()


class SigningPolicy(unittest.TestCase):
    def test_resource_git_launcher_keeps_arguments_and_explicit_environment(self):
        with tempfile.TemporaryDirectory() as directory:
            root = Path(directory)
            application = root / "Fixture With Spaces.app"
            fake_git = root / "git-fixture"
            fake_git.write_text('''#!/bin/sh
case "$1" in
--version) printf 'git version 0.0.1\\n' ;;
--exec-path) printf '%s\\n' "$GIT_EXEC_PATH" ;;
--template-path) printf '%s\\n' "$GIT_TEMPLATE_DIR" ;;
*) printf '%s\\0' "$@" ;;
esac
''')
            text = Path("script/bundle-mac").read_text()
            function = text[text.index("function download_git() {"):text.index("function sign_git_runtime() {")]
            script = '''set -euo pipefail
app_path=$1
GIT_RELEASE_TAG=fixture
GIT_VERSION=v0.0.1
GIT_VERSION_SHA=fixture
GIT_MACOS_ARM64_SHA256=fixture
download_and_unpack() {
    mkdir -p "$2/bin" "$2/libexec/git-core" "$2/share/git-core/templates"
    cp "$SIGNING_TEST_ROOT/git-fixture" "$2/bin/git"
    chmod +x "$2/bin/git"
}
''' + function + '\ndownload_git aarch64-apple-darwin "$app_path/Contents/Resources/git/launch-git"\n'
            environment = dict(os.environ, SIGNING_TEST_ROOT=str(root))
            for name in ("GIT_EXEC_PATH", "GIT_TEMPLATE_DIR"):
                environment.pop(name, None)
            subprocess.run(("bash", "-c", script, "fixture", str(application)), env=environment, capture_output=True, check=True)
            runtime = application / "Contents/Resources/git"
            launcher = runtime / "launch-git"
            def run(argument, **overrides):
                return subprocess.run((str(launcher), argument), env=dict(environment, **overrides), capture_output=True, check=True).stdout.decode().strip()
            self.assertEqual(run("--exec-path"), str(runtime / "libexec/git-core"))
            self.assertEqual(run("--template-path"), str(runtime / "share/git-core/templates"))
            self.assertEqual(run("--exec-path", GIT_EXEC_PATH="/explicit helpers"), "/explicit helpers")
            self.assertEqual(run("--template-path", GIT_TEMPLATE_DIR="/explicit templates"), "/explicit templates")
            arguments = ("argument with spaces", "literal;$(not-a-command)")
            forwarded = subprocess.run((str(launcher), *arguments), env=environment, capture_output=True, check=True).stdout
            self.assertEqual(forwarded.split(b"\0")[:-1], [argument.encode() for argument in arguments])

    def environment(self, platform):
        values = {name: "fixture-only" for name in policy.CREDENTIALS[platform]}
        if platform == "linux":
            values["LINUX_SIGNING_KEY_FINGERPRINT"] = "A" * 40
        if platform == "macos":
            values["MACOS_SIGNING_IDENTITY"] = "Developer ID Application: Test (0123456789)"
        if platform == "windows":
            values.update(FILE_DIGEST="SHA256", TIMESTAMP_DIGEST="SHA256",
                          ENDPOINT="https://eus.codesigning.azure.net/", TIMESTAMP_SERVER="http://timestamp.acs.microsoft.com")
        return values

    def test_complete_partial_empty_and_development_policy(self):
        for platform in policy.CREDENTIALS:
            complete = self.environment(platform)
            self.assertTrue(policy.validate(platform, "required", complete))
            for name in complete:
                for empty in ("", " \t"):
                    partial = dict(complete, **{name: empty})
                    with self.assertRaisesRegex(ValueError, name):
                        policy.validate(platform, "required", partial)
                    self.assertFalse(policy.validate(platform, "auto", partial))
            self.assertFalse(policy.validate(platform, "off", complete))
            self.assertFalse(policy.validate(platform, "auto", {}))
            with self.assertRaisesRegex(ValueError, "conflicts"):
                policy.validate(platform, "required", dict(complete, ZED_DISABLE_SIGNING="1"))

    def test_production_parameters_are_not_silently_downgraded(self):
        for platform, name, value in (("macos", "MACOS_SIGNING_IDENTITY", "-"),
                                      ("windows", "FILE_DIGEST", "SHA1"),
                                      ("windows", "TIMESTAMP_SERVER", "http://invalid.example"),
                                      ("windows", "ENDPOINT", "https://invalid.example"),
                                      ("windows", "ENDPOINT", "https://invalid.example/.codesigning.azure.net"),
                                      ("windows", "ENDPOINT", "https://eus.codesigning.azure.net@invalid.example/.codesigning.azure.net"),
                                      ("windows", "ENDPOINT", "https://eus.codesigning.azure.net:443/")):
            with self.assertRaises(ValueError):
                policy.validate(platform, "required", dict(self.environment(platform), **{name: value}))

    def test_cli_does_not_echo_secret_values(self):
        result = subprocess.run(("python3", "script/check-signing-environment", "--platform", "macos", "--policy", "required"),
                                env={"PATH": os.environ["PATH"], "MACOS_CERTIFICATE": "PRIVATE_FIXTURE_DO_NOT_ECHO"}, capture_output=True)
        self.assertNotEqual(result.returncode, 0)
        self.assertNotIn(b"PRIVATE_FIXTURE_DO_NOT_ECHO", result.stdout + result.stderr)

    def test_linux_signature_status_rejects_wrong_key_digest_and_revocation(self):
        fingerprint = "A" * 40
        valid = f"[GNUPG:] VALIDSIG {fingerprint} 2026-10-30 1793318400 0 4 0 22 8 00 {fingerprint}"
        linux_signature.verify_fingerprint(valid, fingerprint)
        for invalid in (valid.replace("22 8", "22 2"), valid + "\n[GNUPG:] REVKEYSIG " + fingerprint,
                        valid + "\n[GNUPG:] KEYEXPIRED 1", "[GNUPG:] BADSIG " + fingerprint,
                        valid.replace(fingerprint, "B" * 40)):
            with self.assertRaises(ValueError):
                linux_signature.verify_fingerprint(invalid, fingerprint)

    def test_mac_cleanup_after_import_failure_without_default_keychain_mutation(self):
        with tempfile.TemporaryDirectory() as directory:
            root = Path(directory)
            security = root / "security"
            security.write_text('''#!/bin/bash
case "$1" in
create-keychain) touch "${@: -1}" ;;
import) exit 37 ;;
delete-keychain) rm "$2"; echo deleted > "$SIGNING_TEST_ROOT/deleted" ;;
default-keychain|list-keychains) exit 99 ;;
esac
''')
            security.chmod(0o755)
            environment = dict(os.environ, PATH=str(root) + os.pathsep + os.environ["PATH"], TMPDIR=str(root),
                               SIGNING_TEST_ROOT=str(root), MACOS_CERTIFICATE="Zml4dHVyZQ==", MACOS_CERTIFICATE_PASSWORD="fixture",
                               APPLE_NOTARIZATION_KEY="fixture")
            result = subprocess.run(("bash", "-c", "set -euo pipefail; source script/lib/macos-signing.sh; IDENTITY=fixture; setup_production_signing"),
                                    env=environment, capture_output=True)
            self.assertEqual(result.returncode, 37, result.stderr)
            self.assertTrue((root / "deleted").is_file())
            self.assertFalse(list(root.glob("copper-signing.*")))

    def test_mac_search_list_is_available_to_codesign_and_restored_on_every_exit(self):
        for failure, expected_status in (("", 0), ("sign", 41), ("register", 1), ("identity", 1)):
            with self.subTest(failure=failure), tempfile.TemporaryDirectory() as directory:
                root = Path(directory)
                original = ["/fixture/Login Keychain.keychain-db", '/fixture/quoted "name".keychain-db']
                (root / "search-list.json").write_text(json.dumps(original))
                security = root / "security"
                security.write_text('''#!/usr/bin/env python3
import json, os, shlex, sys
from pathlib import Path
root = Path(os.environ["SIGNING_TEST_ROOT"])
state = root / "search-list.json"
command, *arguments = sys.argv[1:]
failure = os.environ["SIGNING_TEST_FAILURE"]
if command == "create-keychain":
    Path(arguments[-1]).touch()
elif command == "list-keychains":
    if "-s" in arguments:
        keychains = arguments[arguments.index("-s") + 1:]
        state.write_text(json.dumps(keychains))
        if failure == "register" and any("copper-signing." in path for path in keychains):
            sys.exit(29)
    else:
        print("\\n".join(shlex.quote(path) for path in json.loads(state.read_text())))
elif command == "find-identity":
    if failure == "identity":
        sys.exit(45)
    print('1) fixture-hash "fixture"')
elif command == "delete-keychain":
    if any("copper-signing." in path for path in json.loads(state.read_text())):
        sys.exit(46)
    Path(arguments[-1]).unlink()
    (root / "deleted").touch()
elif command == "default-keychain":
    sys.exit(99)
''')
                security.chmod(0o755)
                codesign = root / "codesign"
                codesign.write_text('''#!/usr/bin/env python3
import json, os, sys
from pathlib import Path
root = Path(os.environ["SIGNING_TEST_ROOT"])
keychain = sys.argv[sys.argv.index("--keychain") + 1]
if keychain not in json.loads((root / "search-list.json").read_text()):
    sys.exit(44)
(root / "codesign-called").touch()
sys.exit(41 if os.environ["SIGNING_TEST_FAILURE"] == "sign" else 0)
''')
                codesign.chmod(0o755)
                environment = dict(os.environ, PATH=str(root) + os.pathsep + os.environ["PATH"],
                                   TMPDIR=str(root), SIGNING_TEST_ROOT=str(root), SIGNING_TEST_FAILURE=failure,
                                   MACOS_CERTIFICATE="Zml4dHVyZQ==", MACOS_CERTIFICATE_PASSWORD="fixture",
                                   APPLE_NOTARIZATION_KEY="fixture")
                result = subprocess.run(("bash", "-c", '''set -euo pipefail
source script/lib/macos-signing.sh
IDENTITY=fixture
setup_production_signing
codesign --sign "$IDENTITY" "${signing_keychain_arguments[@]}" fixture
'''), env=environment, capture_output=True)
                self.assertEqual(result.returncode, expected_status, result.stderr)
                self.assertEqual(json.loads((root / "search-list.json").read_text()), original)
                self.assertTrue((root / "deleted").is_file())
                self.assertEqual((root / "codesign-called").exists(), failure in ("", "sign"))
                self.assertFalse(list(root.glob("copper-signing.*")))


@unittest.skipUnless(shutil.which("gpg") and shutil.which("gpgconf"), "GnuPG is unavailable on this host; real Linux CI is required")
class LinuxSignature(unittest.TestCase):
    def test_real_fixture_key_signs_archive_and_rejects_tampering(self):
        with tempfile.TemporaryDirectory(prefix="copper-gpg-fixture-") as directory:
            home = Path(directory) / "key-home"
            home.mkdir(mode=0o700)
            environment = dict(os.environ, GNUPGHOME=str(home))
            def gpg(*arguments, data=None):
                return subprocess.run(("gpg", "--batch", "--no-tty", *arguments), env=environment,
                                      input=data, capture_output=True, check=True).stdout
            try:
                gpg("--pinentry-mode", "loopback", "--passphrase-fd", "0", "--quick-generate-key",
                    "Copper fixture <fixture@example.invalid>", "ed25519", "sign", "1d", data=b"fixture-only\n")
                fields = gpg("--with-colons", "--list-secret-keys").decode().splitlines()
                fingerprint = next(line.split(":")[9] for line in fields if line.startswith("fpr:"))
                private = gpg("--pinentry-mode", "loopback", "--passphrase-fd", "0", "--armor", "--export-secret-keys",
                              fingerprint, data=b"fixture-only\n")
                archive = Path(directory) / "fixture.tar.gz"
                archive.write_bytes(b"archive fixture")
                signing_environment = dict(environment, LINUX_SIGNING_KEY=base64.b64encode(private).decode(),
                                           LINUX_SIGNING_KEY_PASSWORD="fixture-only", LINUX_SIGNING_KEY_FINGERPRINT=fingerprint)
                result = subprocess.run(("python3", "script/sign-linux-archive", str(archive)),
                                        env=signing_environment, capture_output=True)
                self.assertEqual(result.returncode, 0, result.stderr)
                signature = str(archive) + ".asc"
                self.assertIn(b"BEGIN PGP PUBLIC KEY BLOCK", Path(str(archive) + ".pub").read_bytes())
                self.assertNotIn(b"PRIVATE KEY BLOCK", Path(str(archive) + ".pub").read_bytes())
                gpg("--verify", signature, str(archive))
                verify_environment = {"PATH": os.environ["PATH"], "LINUX_SIGNING_KEY_FINGERPRINT": fingerprint}
                verified = subprocess.run(("python3", "script/sign-linux-archive", "--verify-only", str(archive)),
                                          env=verify_environment, capture_output=True)
                self.assertEqual(verified.returncode, 0, verified.stderr)
                archive.write_bytes(b"tampered")
                with self.assertRaises(subprocess.CalledProcessError):
                    gpg("--verify", signature, str(archive))
                rejected = subprocess.run(("python3", "script/sign-linux-archive", "--verify-only", str(archive)),
                                          env=verify_environment, capture_output=True)
                self.assertNotEqual(rejected.returncode, 0)
            finally:
                subprocess.run(("gpgconf", "--homedir", str(home), "--kill", "gpg-agent"), check=True, capture_output=True)


class RuntimePackage(unittest.TestCase):
    def test_pinned_archive_and_receipt_without_network_or_weights(self):
        with tempfile.TemporaryDirectory() as directory:
            root = Path(directory)
            cache = root / "cache"
            cache.mkdir()
            archive = cache / "llama-fixture.zip"
            with zipfile.ZipFile(archive, "w") as output:
                output.writestr("runtime/llama-server.exe", b"runtime fixture")
            asset = {"platform": "windows-x86_64", "name": archive.name,
                     "url": "https://github.com/ggml-org/llama.cpp/releases/download/fixture/" + archive.name,
                     "bytes": archive.stat().st_size, "sha256": hashlib.sha256(archive.read_bytes()).hexdigest()}
            catalog = {"runtime_version": "fixture", "runtime_revision": "abc", "runtime_assets": [asset]}
            destination = root / "package/llama-cpp"
            with patch("urllib.request.urlopen", side_effect=AssertionError("Unexpected network")):
                runtime.stage(catalog, "windows-x86_64", destination, cache)
            receipt = json.loads((destination / ".copper-bundled-runtime.json").read_text())
            self.assertEqual(receipt["assets"]["windows-x86_64"], asset["sha256"])
            self.assertEqual((destination / "windows-x86_64/runtime/llama-server.exe").read_bytes(), b"runtime fixture")
            self.assertFalse(list(destination.rglob("*.gguf")))
            (destination / ".copper-bundled-runtime.json").unlink()
            with self.assertRaisesRegex(ValueError, "not owned"):
                runtime.stage(catalog, "windows-x86_64", destination, cache)

    def test_archive_path_escape_is_rejected(self):
        with tempfile.TemporaryDirectory() as directory:
            root = Path(directory)
            archive = root / "invalid.zip"
            with zipfile.ZipFile(archive, "w") as output:
                output.writestr("../escape", b"no")
            asset = {"platform": "windows-x86_64", "name": archive.name,
                     "url": "https://github.com/ggml-org/llama.cpp/releases/download/fixture/invalid.zip",
                     "bytes": archive.stat().st_size, "sha256": hashlib.sha256(archive.read_bytes()).hexdigest()}
            with self.assertRaisesRegex(ValueError, "Unsafe"):
                runtime.stage({"runtime_version": "fixture", "runtime_assets": [asset]}, "windows-x86_64", root / "package", root)
            self.assertFalse((root / "escape").exists())


if __name__ == "__main__":
    unittest.main(verbosity=2)
