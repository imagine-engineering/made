#!/usr/bin/env bash
set -euo pipefail
if [[ $# != 2 ]]; then
    printf '%s\n' 'Usage: script/get-released-version <catalog-product-id> <stable|preview>' >&2
    exit 1
fi
python3 script/product_release.py latest --product "$1" --channel "$2" | python3 -c 'import json,sys; print(json.load(sys.stdin)["version"])'
