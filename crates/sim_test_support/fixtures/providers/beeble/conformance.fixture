    {
      "name": "image-auto-False",
      "input": {
        "generation_type": "image",
        "prompt": " \u001c A new look 　",
        "reference_image": false,
        "alpha_mode": "auto",
        "max_resolution": "720p",
        "seed": 7,
        "source_frame_count": 1,
        "mask_frame_count": null
      },
      "expected_request": {
        "generation_type": "image",
        "source_uri": "https://fixture.invalid/source",
        "alpha_mode": "auto",
        "prompt": "A new look",
        "max_resolution": 720
      },
      "expected_uploads": [
        "source_image"
      ],
      "expected_error": false
    },
