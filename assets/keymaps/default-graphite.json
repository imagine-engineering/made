[
  {
    "context": "GraphiteSavedLayers",
    "bindings": {
      "shift-escape": "graphite::SelectParentSavedLayers"
    }
  },
  {
    "context": "GraphiteCanvas",
    "bindings": {
      "alt-g": "graphite::ToggleCanvasGrid",
      "alt-o": "graphite::ToggleCanvasOverlays",
      "ctrl-space": "graphite::ToggleCanvasGraphOverlay",
      "alt-s": "graphite::ToggleCanvasSnapping"
    }
  },
  {
    "context": "GraphiteCanvasPan",
    "bindings": {
      "escape": "graphite::CancelArtboardCanvasPan"
    }
  },
  {
    "context": "GraphiteCanvasArtboardEdit",
    "bindings": {
      "escape": "graphite::CancelArtboardCanvasEdit"
    }
  }
]
